{
  "name": "dsh-scribble",
  "version": "0.2.0",
  "description": "随手笔记 for DeepSeek Harness (dsh)：每篇一个 Markdown 文件的本地笔记插件。卡片式界面、自定义标签管理（可提前建标签、一处删除全局生效）、全文搜索、自动保存、Markdown 渲染预览、附件与 Office 零依赖文本抽取、对话一键回写。",
  "license": "MIT",
  "author": "amd47802574",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amd47802574/dsh-scribble.git"
  },
  "homepage": "https://github.com/amd47802574/dsh-scribble#readme",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "notes",
    "markdown",
    "knowledge"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2"
  }
}
